APP_ENV=development
SESSION_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./data/manshi.sqlite3
BUSINESS_TIMEZONE=Asia/Shanghai
SESSION_EXPIRE_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080
PUBLIC_PORT=8080

# roster: 用户确认的30人初始数据；empty: 仅管理员和四部门（测试/从零手工建档）
INITIAL_DATA_MODE=roster
